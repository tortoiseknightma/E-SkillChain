# 复制为 .env 并填入真实密钥（.env 已被 gitignore）。
# 配置模块可能加载 .env，但默认 pytest 会排除 integration，不会使用凭据发起模型调用；
# 测试进程的 Python socket guard 会阻断 DNS/connect。真实冒烟必须显式运行：
# uv run pytest -m integration tests/test_llm.py

# Qwen Assistant 与 Qwen3.7 Feedback 使用 DashScope 凭据。
DASHSCOPE_API_KEY=sk-xxxx

# 可选端点覆盖；不设置时使用下列默认值。端点会进入 LLMResponse/RunManifest。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Kimi compatible endpoint 只供历史/可选实验；当前 v8 主链不使用 Kimi Final Judge。
# 若使用独立业务空间，可取消注释并替换 YOUR_WORKSPACE_ID；不要填 Kimi For Coding key。
# KIMI_DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Final Judge 使用 AIFast 的 OpenAI-compatible Gemini 3.6 Flash。
GEMINI_API_KEY=sk-xxxx
AIFAST_BASE_URL=https://www.aifast.club/v1

# 仅当显式使用 llm.chat(provider="claude") 时需要。
# 当前 Creator/Refiner 的 provider=claude_code，不通过 API 调用。
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
